# Virtual environments
.venv*/
venv/
env/

# Agent / local runtime
.pi/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Logs and local state
*.log

# Generated media
outputs/
*.mp4
*.wav
*.flac

# Local build products
dist/

# Downloaded model trees — 由应用内「资源」面板下载
llms/
minimax-h3/
minimax-music3/
image-models/

