{
  "platform": "web",
  "form_factor": "desktop",
  "width_range": {
    "min": 900,
    "max": 2560,
    "basis": "普查 contentMinSize 900（macos/MainWindowController.swift:32）；max 2560 用户确认「900–2560（推荐）」（普查 max 1920，只放宽）"
  },
  "height_range": {
    "min": 600,
    "basis": "普查 macos/VisualProbe.swift:9 → MainWindowController.swift:32 contentMinSize 高 600"
  },
  "layout_thresholds": [
    {
      "width": 1100,
      "unit": "px",
      "basis": "desk/static/app.css:38 @media (max-width:1100px) 状态栏宽或窄文案切换"
    },
    {
      "width": 900,
      "unit": "px",
      "basis": "desk/static/app.css:441 @media (max-width:900px) 素材库预览改成三列，信息栏下移"
    },
    {
      "width": 100,
      "unit": "px",
      "basis": "desk/static/app.css:352 @container (max-width:100px) 会话栏头部（容器宽度，收起后 44px，app.css:340）"
    },
    {
      "width": 1400,
      "unit": "px",
      "basis": "desk/static/app.css:2 --chat-col:1400px；app.css:54,83,199,288 主列 max-width，两侧各 24px"
    },
    {
      "width": 1300,
      "unit": "px",
      "basis": "desk/static/app.css:174 .firstrun-wrap max-width:min(1300px,calc(100% - 48px))"
    },
    {
      "width": 1200,
      "unit": "px",
      "basis": "desk/static/app.css:423 .dialog.lib-preview max-width:min(1200px,calc(100vw - 48px))"
    },
    {
      "width": 760,
      "unit": "px",
      "basis": "desk/static/app.css:320 .media-picker max-width"
    },
    {
      "width": 640,
      "unit": "px",
      "basis": "desk/static/app.css:74,162 skill 面板与 .dialog-wide max-width"
    },
    {
      "width": 480,
      "unit": "px",
      "basis": "desk/static/app.css:156 .dialog max-width"
    },
    {
      "width": 420,
      "unit": "px",
      "basis": "desk/static/app.css:165 #pane-settings width:min(420px,100%)"
    },
    {
      "width": 248,
      "unit": "px",
      "basis": "desk/static/app.css:51 .sessions width:248px；app.css:348 .sessions>ul min-width:240px"
    },
    {
      "width": 900,
      "unit": "pt",
      "basis": "macos/VisualProbe.swift:8 MainWindowMinSize.width → macos/MainWindowController.swift:32 contentMinSize"
    }
  ],
  "locales": {
    "supported": [
      "zh-CN"
    ],
    "default": "zh-CN",
    "rtl": [],
    "basis": "没有 i18n 资源，文案写死在源码里：desk/static/index.html:2 lang=zh-CN；packaging/Info.plist.template:11-15 CFBundleDevelopmentRegion zh_CN，CFBundleLocalizations zh-Hans；macos/*.swift 文案也是中文硬编码",
    "declined": []
  },
  "axis_support": {
    "appearance": {
      "supported": [
        "dark"
      ],
      "basis": "desk/static/app.css:2 :root{color-scheme:dark}，没有 prefers-color-scheme 和 data-theme；macos/AppDelegate.swift:16 NSApp.appearance=.darkAqua；errorPageHTML 写死深色（macos/ShellStatus.swift:105）。菜单栏状态图标是模板图（macos/StatusItemController.swift:88-91），会跟随系统菜单栏明暗",
      "declined": []
    },
    "dynamic_type": {
      "supported": [
        "固定 px 字号（app.css:7 14px，其余全是 px，没有 rem）",
        "WKWebView 没有开 allowsMagnification/pageZoom；在普通浏览器里可用浏览器缩放"
      ],
      "basis": "desk/static/app.css:7,11,12; 在 macos/ 中搜 magnification/pageZoom 没有结果；应用内读回值为「浏览器缩放 100%」（macos/VisualProbe.swift），轴值写成「浏览器缩放 100% + <普查官原文>」",
      "declined": [
        {
          "value": "WKWebView 没有开 allowsMagnification/pageZoom；在普通浏览器里可用浏览器缩放",
          "confirmation": "只验 100%（推荐）",
          "confirmed_at": "2026-10-14T17:42:00+09:00"
        }
      ]
    },
    "orientation": {
      "supported": [
        "landscape"
      ],
      "basis": "桌面窗口，没有 orientation 媒体查询；窗口只设了最小尺寸，用户可拖成竖长窗口（macos/MainWindowController.swift:16 .resizable）",
      "declined": []
    },
    "pointer": {
      "supported": [
        "mouse"
      ],
      "basis": "macOS 加鼠标或触控板，服务只监听 loopback；没有 hover/pointer 媒体查询；悬停才出现的控件：app.css:112,270 .session:hover .session-actions，app.css:390 .lib-audition:hover，library.js:345 mouseenter 悬停播放；media_session.js:286 只监听 touchmove 用于判断滚动意图；app.css:190-194 细滚动条（接鼠标时 macOS 常显）",
      "declined": []
    }
  },
