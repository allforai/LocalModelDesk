   "declined": []
  },
  "dynamic_type": {
   "supported": [
    "浏览器缩放 100%"
   ],
   "basis": "desk/static/app.css:7 body{font:14px/1.5}，字号一律 px（13/14/16/20/12px），无 rem/em 字号、无 clamp()、无 .dynamicTypeSize；仅 app.css:44 的 40em 与 app.css:163 的 12em 是 em 长度。代码未声明任何字号缩放分支，缩放行为全靠宿主 WKWebView",
   "declined": []
  },
  "orientation": {
   "supported": [
    "landscape"
   ],
   "basis": "macOS 桌面窗口本身（macos/MainWindowController.swift:15）；全树无 CSS orientation 媒体查询、无 UISupportedInterfaceOrientations、无 android:screenOrientation——代码没有任何按方向的分支",
   "declined": []
  },
  "pointer": {
   "supported": [
    "mouse"
   ],
   "basis": "平台本身：macOS 应用包里的 WKWebView（macos/MainWindowController.swift:26）。app.css 无 (hover: hover)/(pointer: fine|coarse)/(any-pointer: coarse) 查询，也无 touch/pointer 事件监听；但存在只在指点设备悬停时才出现的控件——desk/static/app.css:79-80 .session-actions{visibility:hidden} + .session:hover/.session:focus-within 才可见，以及 desk/static/app.css:165-168 的常显滚动条样式（注释注明「接鼠标时 macOS 常显滚动条」，tests/e2e/conftest.py:59 也为此关掉 --hide-scrollbars）。macos/VisualProbe.swift:26-28 在运行时读回 pointer/hover/any_pointer_coarse，说明真实指点设备由环境决定而非代码",
   "declined": []
  }
 },
